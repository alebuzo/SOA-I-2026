{
  "consumer": {
    "name": "InventarioClient"
  },
  "interactions": [
    {
      "description": "GET /books returns a list",
      "pending": false,
      "providerStates": [
        {
          "name": "at least one book exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/books"
      },
      "response": {
        "body": {
          "content": [
            {
              "author": "Author Name",
              "available": true,
              "bookId": 1,
              "edition": 1,
              "isbn": "978-0-00-000000-0",
              "notes": "Some notes about the book",
              "title": "Example Book"
            }
          ],
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].author": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].available": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "boolean"
                }
              ]
            },
            "$[*].bookId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[*].edition": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[*].isbn": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].notes": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
    {
      "description": "GET /books/3 returns the book",
      "pending": false,
      "providerStates": [
        {
          "name": "a book with bookId 3 exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/books/3"
      },
      "response": {
        "body": {
          "content": {
            "author": "Author Name",
            "available": true,
            "bookId": 3,
            "edition": 1,
            "isbn": "978-0-00-000000-0",
            "notes": "Some notes about the book",
            "title": "Example Book"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.author": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.available": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "boolean"
                }
              ]
            },
            "$.edition": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.isbn": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.notes": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
    {
      "description": "GET /books/9999 returns 404",
      "pending": false,
      "providerStates": [
        {
          "name": "no book with bookId 9999 exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/books/9999"
      },
      "response": {
        "body": {
          "content": {
            "message": "not found"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 404
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
    {
      "description": "POST /books creates a new book",
      "pending": false,
      "providerStates": [
        {
          "name": "any state"
        }
      ],
      "request": {
        "body": {
          "content": {
            "author": "Author Name",
            "edition": 3,
            "isbn": "978-0-00-000000-0",
            "title": "New Book"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "method": "POST",
        "path": "/books"
      },
      "response": {
        "body": {
          "content": {
            "author": "Author Name",
            "bookId": 1,
            "edition": 3,
            "isbn": "978-0-00-000000-0",
            "title": "New Book"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.bookId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 201
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.5.4",
      "mockserver": "2.2.1",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "FlaskInventarioAPI"
  }
